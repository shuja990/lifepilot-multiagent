# ==========================================================================
# LifePilot — environment
# Copy to `.env` and fill in. Every key below has a free tier; none need a
# credit card unless noted. Phase 0 (tool layer) only needs the ones marked
# [PHASE 0]. The rest can stay blank until the phase that uses them.
# ==========================================================================

# --------------------------------------------------------------------------
# LLM — Gemini (the default for every agent)
# --------------------------------------------------------------------------
# Get a free key (no credit card): https://aistudio.google.com/apikey
# The TS SDK actually reads GEMINI_API_KEY / GOOGLE_GENAI_API_KEY; the app
# aliases GOOGLE_API_KEY onto those, so setting this one alone is enough.
# Free tier is Flash / Flash-Lite only; Pro is paid-only since ~Apr 2026.
# NOTE: free-tier prompts may be used by Google to improve their products —
# do not send real personal data through the deployed demo.
GOOGLE_API_KEY=

# Tells the google-genai SDK to use AI Studio (free key) and not Vertex AI.
# Leave as FALSE unless you deliberately move to Vertex (which bills).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model ids. Keep these here — no model name should appear anywhere else.
# PIN them; do NOT use the `-latest` aliases. `gemini-flash-latest` currently
# resolves to gemini-3.7-flash, whose free tier is 20 requests/DAY.
GEMINI_MODEL_DEFAULT=gemini-3.6-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# --------------------------------------------------------------------------
# LLM — additional providers (Phase 2+, all optional)
# The OpenAI-compatible adapter covers all three. Leave blank to run
# Gemini-only; the router just won't offer these tiers.
# --------------------------------------------------------------------------
# Free tier, very fast: https://console.groq.com/keys
GROQ_API_KEY=
# Cheapest paid fallback (~$0.14/M in): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional gateway to Claude/GPT. Costs real money — see PREMIUM_ENABLED.
OPENROUTER_API_KEY=

# Guard rail: when false, the router will never select a paid premium model,
# no matter what the routing policy says. Keep false for the public demo.
PREMIUM_ENABLED=false

# --------------------------------------------------------------------------
# Tools [PHASE 0]
# --------------------------------------------------------------------------
# Places + geocoding. Free plan = 3,000 credits/day, no credit card.
# Sign up: https://myprojects.geoapify.com/  →  create a project → API key
GEOAPIFY_API_KEY=

# Web search. Free = 1,000 credits/month, no credit card.
# Sign up: https://app.tavily.com/  →  the key looks like tvly-xxxxxxxx
TAVILY_API_KEY=

# Weather  → Open-Meteo    (no key, no signup, nothing to do here)
# Currency → ExchangeRate-API (no key, no signup, nothing to do here)

# --------------------------------------------------------------------------
# Storage (Phase 5)
# --------------------------------------------------------------------------
# Free Postgres, no card: https://console.neon.tech/  → copy the pooled
# connection string. Leave blank in Phase 0 — tools fall back to a local
# JSON store under .data/ so you can develop with no database at all.
DATABASE_URL=

# --------------------------------------------------------------------------
# Notifications (Phase 6)
# --------------------------------------------------------------------------
# Generate a keypair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Signs login tokens. Generate with `openssl rand -hex 32`.
# Changing it logs everyone out, which is the intended emergency lever.
AUTH_SECRET=

# Shared secret so only your GitHub Actions cron can call POST /tick.
# Any long random string: `openssl rand -hex 32`
TICK_SECRET=

# --------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------
PORT=8080
# Where the web app looks for the API. Set this in Vercel to the deployed API
# origin; it is baked into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info
